# ScrollSense Root Docker Compose & Deployment Environment Configuration
# Copy this file to .env and configure secrets prior to deployment

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/scrollsense

# JWT Secret (minimum 32 random characters for production security)
JWT_SECRET=change_this_to_a_secure_random_32_character_string_for_production

# Device Token Salt (used for hashing device pairing credentials)
DEVICE_TOKEN_SALT=change_this_to_a_unique_device_salt_secret_in_production

# Internal Service Shared Key (authenticates backend requests to FastAPI)
INTERNAL_API_KEY=change_this_internal_ai_secret_key_in_production

# AI LLM Provider: 'fallback' (zero external dependencies), 'gemini', or 'openai'
LLM_PROVIDER=fallback

# External LLM API Keys (optional if LLM_PROVIDER=fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ports
BACKEND_PORT=5000
FRONTEND_PORT=3000
AI_PORT=8000
