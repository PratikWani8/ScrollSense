# ScrollSense AI Microservice Environment Configuration
PORT=8000
HOST=0.0.0.0

# LLM Provider: 'fallback' (100% deterministic local rules), 'gemini', or 'openai'
LLM_PROVIDER=fallback

# API Keys (required only if LLM_PROVIDER is set to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=

# LLM Model Name
LLM_MODEL_NAME=gemini-1.5-flash

# Internal Authentication Key shared with Node.js Express backend
INTERNAL_API_KEY=scrollsense_internal_ai_secret_key

# Service Limits & Timeouts
TIMEOUT_SECONDS=10.0
MAX_RETRIES=2
CACHE_TTL_SECONDS=3600

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
