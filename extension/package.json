{
  "name": "scrollsense-extension",
  "version": "1.0.0",
  "private": true,
  "description": "ScrollSense Chrome Extension (Manifest V3) for tracking Instagram Reels & YouTube Shorts",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
